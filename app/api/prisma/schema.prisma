generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A concrete scheduled itinerary customers can book: one country with a
// fixed date window and price. Served by GET /trips.
model Trip {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country        String
  departureDate  DateTime  @map("departure_date") @db.Date
  arrivalDate    DateTime  @map("arrival_date") @db.Date
  pricePerPerson Decimal   @map("price_per_person") @db.Decimal(10, 2)
  currency       String    @default("USD")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bookings       Booking[]

  @@map("trips")
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique
  phone     String
  // Nullable so existing rows migrate cleanly; a user without a password
  // simply cannot obtain a token.
  passwordHash String? @map("password_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bookings  Booking[]

  @@map("users")
}

// Destination, dates and price are a snapshot copied from the trip at booking
// time. tripId is nullable only because early bookings predate trips;
// userId is null for guest bookings.
model Booking {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId             String?  @map("trip_id") @db.Uuid
  trip               Trip?    @relation(fields: [tripId], references: [id])
  userId             String?  @map("user_id") @db.Uuid
  user               User?    @relation(fields: [userId], references: [id])
  destinationId      String   @map("destination_id")
  destinationCountry String   @map("destination_country")
  departureCountry   String   @map("departure_country")
  departureDate      DateTime @map("departure_date") @db.Date
  arrivalDate        DateTime @map("arrival_date") @db.Date
  adults             Int
  children           Int
  travelerFirstName  String   @map("traveler_first_name")
  travelerLastName   String   @map("traveler_last_name")
  travelerPhone      String   @map("traveler_phone")
  travelerEmail      String   @map("traveler_email")
  pricePerPerson     Decimal  @map("price_per_person") @db.Decimal(10, 2)
  totalPrice         Decimal  @map("total_price") @db.Decimal(10, 2)
  currency           String
  status             String   @default("CONFIRMED")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("bookings")
}
